# ─── Supabase ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Google AI (Gemini) ─────────────────────────────────────────────
GOOGLE_AI_API_KEY=your-gemini-api-key
APIFY_API_TOKEN=your-apify-api-token

# ─── Vercel Cron Secret ─────────────────────────────────────────────
# Vercel Cron이 API를 호출할 때 사용하는 시크릿 토큰
# 보안을 위해 랜덤 문자열 사용 (예: openssl rand -hex 32)
CRON_SECRET=your-cron-secret-token

# ─── Trend Feed Sources ────────────────────────────────────────────
# YouTube Data API v3 key. Required for YouTube Shorts collection.
YOUTUBE_API_KEY=your-youtube-data-api-key
# Optional JSON input accepted by the configured TikTok Actor.
APIFY_TREND_TIKTOK_INPUT_JSON={}

# ─── Public site URL ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# ─── Rate limiting ──────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Payment (Optional) ─────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_PAYMENT=false
# Required before setting NEXT_PUBLIC_ENABLE_PAYMENT=true. Keep all values server-only except
# provider publishable/client keys used by an approved browser SDK integration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TOSS_PAYMENTS_SECRET_KEY=

# AdSense can display a regular, non-rewarded slot. A browser AdSense view must never grant credits.
NEXT_PUBLIC_ADSENSE_DISPLAY_SLOT=

# Reward credits stay disabled until a provider-specific SSV implementation with signed event IDs is added.
NEXT_PUBLIC_ENABLE_ADS_REWARD=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
